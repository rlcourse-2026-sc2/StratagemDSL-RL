// Negative Trap (关门捉贼): the depot wall is raised in the first phase, before
// the raiders are admitted and commit, so the closure does not follow the
// commitment. Same actions and roles as examples/seeds/gmzz.strat, moved.
// Expected: C141_TRAP_COMMIT_TO_CLOSURE
strategy gmzz_closed_before_commit {
  world {
    asset gate_a { side = ally; role = barrier; }
    asset gate_b { side = ally; role = barrier; }
    asset gate_c { side = ally; role = barrier; }
    force allied_defenders { side = ally; role = trap_force; }
    force enemy_raiders { side = enemy; role = mobile_raiders; }
    asset support_a { side = enemy; role = static_support; }
    asset support_b { side = enemy; role = static_support; }
    asset support_c { side = enemy; role = static_support; }
    region retreat_checkpoint { role = fallback; }
    region support_return_zone { role = support_return; }
  }
  initial { alive(allied_defenders); alive(enemy_raiders); }
  intent {
    pattern Trap {
      enemy = enemy_raiders;
      lure = allied_defenders;
      way_out = gate_a;
      trap_force = allied_defenders;
      objective = enemy_raiders;
    }
    primary defeated(enemy_raiders);
    secondary alive(allied_defenders);
    success defeated(enemy_raiders);
    failure not alive(allied_defenders);
  }
  plan {
    start [gate_control];
    phase gate_control {
      purpose "Keep the depot wall under player control until the raiders are admitted.";
      actors [allied_defenders]; focus [enemy_raiders];
      do parallel { set_mode(gate_a, "raised"); set_mode(gate_b, "raised"); set_mode(gate_c, "raised"); }
    }
    phase enemy_committed {
      purpose "Enemy Zerglings attack the Marines after a depot is lowered; once committed, the player is expected to raise the depot wall and remove the escape route.";
      actors [enemy_raiders]; focus [allied_defenders];
    }
    phase retreating {
      purpose "After sufficient losses or a raised barrier, the enemy attempts to regain Spine Crawler support.";
      actors [enemy_raiders]; focus [retreat_checkpoint];
    }
    phase escaped {
      purpose "Enemy reaches its fallback corridor; the trap has failed to isolate it.";
      actors [enemy_raiders]; focus [support_return_zone]; terminal failure;
    }
    phase trapped_success {
      purpose "The mobile enemy force is destroyed before it regains static support.";
      actors [allied_defenders]; focus [enemy_raiders]; terminal success;
    }
    transition lower_a: gate_control -> enemy_committed { on ability_completed(gate_a, "SupplyDepotLower"); do { attack(enemy_raiders, allied_defenders); } priority 10; }
    transition lower_b: gate_control -> enemy_committed { on ability_completed(gate_b, "SupplyDepotLower"); do { attack(enemy_raiders, allied_defenders); } priority 20; }
    transition lower_c: gate_control -> enemy_committed { on ability_completed(gate_c, "SupplyDepotLower"); do { attack(enemy_raiders, allied_defenders); } priority 30; }
    transition losses_force_retreat: enemy_committed -> retreating {
      on unit_died(enemy_raiders); when count(enemy_raiders) <= 6; do { retreat(enemy_raiders, retreat_checkpoint); } priority 10;
    }
    transition raise_a_forces_retreat: enemy_committed -> retreating {
      on ability_completed(gate_a, "SupplyDepotRaise"); when distance(enemy_raiders, allied_defenders) >= 18; do { retreat(enemy_raiders, retreat_checkpoint); } priority 20;
    }
    transition raise_b_forces_retreat: enemy_committed -> retreating {
      on ability_completed(gate_b, "SupplyDepotRaise"); when distance(enemy_raiders, allied_defenders) >= 18; do { retreat(enemy_raiders, retreat_checkpoint); } priority 30;
    }
    transition raise_c_forces_retreat: enemy_committed -> retreating {
      on ability_completed(gate_c, "SupplyDepotRaise"); when distance(enemy_raiders, allied_defenders) >= 18; do { retreat(enemy_raiders, retreat_checkpoint); } priority 40;
    }
    transition raiders_reach_checkpoint: retreating -> escaped {
      on enter(enemy_raiders, retreat_checkpoint); do { move(enemy_raiders, support_return_zone); } priority 20;
    }
    transition raiders_destroyed: retreating -> trapped_success {
      on unit_died(enemy_raiders); when count(enemy_raiders) == 0; priority 10;
    }
  }
  binding sc2 {
    gate_a = unit(owner=1, unit_type="SupplyDepot", at=point_id(36022368));
    gate_b = unit(owner=1, unit_type="SupplyDepot", at=point_id(515963392));
    gate_c = unit(owner=1, unit_type="SupplyDepot", at=point_id(357677958));
    allied_defenders = unit_group(owner=1, unit_type="Marine", count=5, spawn=point_id(1922637032));
    enemy_raiders = unit_group(owner=2, unit_type="Zergling", count=8, spawn=point_id(964991801));
    support_a = unit(owner=2, unit_type="SpineCrawler", at=point_id(1553954260));
    support_b = unit(owner=2, unit_type="SpineCrawler", at=point_id(810154836));
    support_c = unit(owner=2, unit_type="SpineCrawler", at=point_id(401521942));
    retreat_checkpoint = circle(center=point_id(381816086), radius=2);
    support_return_zone = circle(center=point_id(298592631), radius=2);
  }
}