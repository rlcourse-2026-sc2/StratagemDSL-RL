// Negative Feint (声东击西): the decoy's entry moves the defenders to the real
// target instead of the fake one.
// Expected: C101_FEINT_THREAT_TO_RELOCATION, C102_FEINT_RELOCATION_TO_WEAKENING, C103_FEINT_WEAKENING_TO_EXPLOIT
strategy sdjx {
  world {
    force feint_force { side = ally; role = decoy; }
    force main_force { side = ally; role = main_attack; }
    force defenders { side = enemy; role = mobile_defense; }
    asset enemy_main { side = enemy; role = fake_target; }
    asset enemy_expansion { side = enemy; role = real_target; }
    asset gas_a { side = enemy; role = scenery; }
    asset gas_b { side = enemy; role = scenery; }
    asset enemy_pylon { side = enemy; role = support; }
    region main_threat_zone { role = feint_trigger; }
    region expansion_zone { role = premature_attack_trigger; }
  }
  initial { alive(feint_force); alive(main_force); alive(defenders); alive(enemy_main); alive(enemy_expansion); }
  intent {
    pattern Feint {
      decoy = feint_force;
      fake_target = enemy_main;
      defenders = defenders;
      main_force = main_force;
      real_target = enemy_expansion;
    }
    primary destroyed(enemy_expansion);
    secondary alive(main_force);
    success destroyed(enemy_expansion);
    failure not alive(main_force);
  }
  semantics { derive expansion_exposed = in_region(feint_force, main_threat_zone); }
  plan {
    start [feint, prepare_strike, expansion_watch];
    phase feint {
      purpose "Use Medivacs to create a credible threat against the high-ground main Nexus.";
      actors [feint_force]; focus [enemy_main]; do { move(feint_force, main_threat_zone); }
    }
    phase prepare_strike {
      purpose "Keep the Marine main force available for the real expansion attack.";
      actors [main_force]; focus [enemy_expansion]; do { hold(main_force); }
    }
    phase expansion_watch {
      purpose "Watch for a premature direct approach to the expansion before the feint succeeds.";
      actors [main_force]; focus [enemy_expansion];
    }
    phase premature_attack {
      purpose "If the main force approaches too early, enemy defenders re-protect the expansion.";
      actors [defenders]; focus [enemy_expansion]; terminal failure;
    }
    join strike_ready all;
    phase strike {
      purpose "Attack the expansion after the mobile defenders have been pulled to the main base.";
      actors [main_force]; focus [enemy_expansion]; do { attack(main_force, enemy_expansion); } terminal success;
    }
    transition feint_induces_redeploy: feint -> strike_ready {
      on enter(feint_force, main_threat_zone); do { retarget(defenders, enemy_expansion); } priority 10;
    }
    transition main_force_ready: prepare_strike -> strike_ready { when alive(main_force); priority 10; }
    transition premature_expansion_approach: expansion_watch -> premature_attack {
      on enter(main_force, expansion_zone); when not expansion_exposed;
      do { retarget(defenders, enemy_expansion); } priority 10;
    }
    transition launch_real_attack: strike_ready -> strike { when expansion_exposed and alive(main_force); priority 10; }
  }
  binding sc2 {
    feint_force = unit_group(owner=1, composition=[
      unit(unit_type="Medivac", count=2, at=point_id(336436468)),
      unit(unit_type="Medivac", count=2, at=point_id(1017891732))
    ], spawn=point_id(336436468));
    main_force = unit_group(owner=1, unit_type="Marine", count=14, spawn=point_id(336436468));
    defenders = unit_group(owner=2, composition=[unit(unit_type="Colossus", count=3), unit(unit_type="Stalker", count=4), unit(unit_type="Zealot", count=5)], spawn=point_id(16402191));
    enemy_main = unit(owner=2, unit_type="Nexus", at=point_id(1887249362));
    enemy_expansion = unit(owner=2, unit_type="Nexus", at=point_id(396610334));
    gas_a = unit(owner=2, unit_type="Assimilator", at=point_id(1977438158));
    gas_b = unit(owner=2, unit_type="Assimilator", at=point_id(250759362));
    enemy_pylon = unit(owner=2, unit_type="Pylon", at=point_id(1431291728));
    main_threat_zone = circle(center=point_id(1887249362), radius=8);
    expansion_zone = circle(center=point_id(396610334), radius=8);
  }
}