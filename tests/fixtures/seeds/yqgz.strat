strategy yqgz {
  world {
    force zergling_force { side = ally; role = bait_and_main; }
    force enemy_siege_force { side = enemy; role = entrenched; }
    force enemy_support_force { side = enemy; role = support; }
    region tank_range { role = sacrifice_zone; }
    region allied_origin { role = counterattack_anchor; }
  }
  initial { alive(zergling_force); alive(enemy_siege_force); alive(enemy_support_force); }
  intent {
    pattern SacrificeBait;
    primary defeated(enemy_siege_force);
    secondary alive(zergling_force);
    success defeated(enemy_siege_force) and defeated(enemy_support_force);
    failure not alive(zergling_force);
  }
  semantics {
    derive bait_threshold_reached = count_in(zergling_force, tank_range) == 0 and killed_in(zergling_force, tank_range) >= 3;
  }
  plan {
    start [entrenched];
    phase entrenched {
      purpose "Siege Tanks and Marines remain in a strong defensive posture.";
      actors [enemy_siege_force, enemy_support_force]; focus [tank_range];
    }
    phase sacrifice_bait {
      purpose "Commit a bounded Zergling detachment into the tank firing zone.";
      actors [zergling_force]; focus [tank_range]; do { move(zergling_force, tank_range); }
    }
    phase induce_advance {
      purpose "After at least three bait deaths and no surviving bait in range, force the tanks out of Siege mode.";
      actors [enemy_siege_force]; focus [allied_origin];
    }
    phase enemy_advances {
      purpose "After Unsiege completes, the Marines and tanks leave the entrenched position and attack forward.";
      actors [enemy_siege_force, enemy_support_force]; focus [zergling_force];
      do parallel { attack(enemy_siege_force, zergling_force); attack(enemy_support_force, zergling_force); }
    }
    phase counterattack {
      purpose "Use the surviving Zerglings to counterattack after the enemy gives up its positional advantage.";
      actors [zergling_force]; focus [enemy_siege_force, enemy_support_force]; terminal success;
    }
    transition commit_bait: entrenched -> sacrifice_bait { when alive(zergling_force); priority 10; }
    transition loss_threshold: sacrifice_bait -> induce_advance {
      on unit_died(zergling_force); when bait_threshold_reached;
      do { set_mode(enemy_siege_force, "unsieged"); } priority 10;
    }
    transition unsiege_complete: induce_advance -> enemy_advances {
      on ability_completed(enemy_siege_force, "Unsiege"); priority 10;
    }
    transition counter_window: enemy_advances -> counterattack { when alive(zergling_force); priority 10; }
  }
  binding sc2 {
    zergling_force = unit_group(owner=1, unit_type="Zergling", count=24, spawn=point_id(1734272525));
    enemy_siege_force = unit_group(owner=2, unit_type="SiegeTankSieged", count=2, spawn=point_id(87331847));
    enemy_support_force = unit_group(owner=2, unit_type="Marine", count=6, spawn=point_id(1260947834));
    tank_range = circle(center=point_id(87331847), radius=15);
    allied_origin = circle(center=point_id(1734272525), radius=3);
  }
}