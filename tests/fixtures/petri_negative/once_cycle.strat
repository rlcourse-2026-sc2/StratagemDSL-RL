// Expected: P031_CYCLE -- the cycle scout -> report -> scout passes only
// once-per-round phases, so it can never repeat; mark one `repeatable`.
strategy PetriOnceCycle {
  world {
    force allies { side = "ally"; role = "main_attack"; }
    force guards { side = "enemy"; role = "mobile_defense"; }
    asset base { side = "enemy"; role = "critical"; }
    region gate { role = "observation_zone"; }
  }
  intent { primary destroyed(base); success destroyed(base); failure not (alive(allies)); }
  plan {
    start [scout, fail_watch];
    phase scout { purpose "scout"; actors [allies]; do { move(allies, gate); } }
    phase report { purpose "report"; }
    phase win { purpose "win"; terminal success; }
    phase fail_watch { purpose "fail watch"; }
    phase loss { purpose "loss"; terminal failure; }
    transition seen: scout -> report { on enter(allies, gate); priority 10; }
    transition again: report -> scout { when alive(allies); priority 10; }
    transition finish: report -> win { when (destroyed(base) and not (not (alive(allies)))); priority 11; }
    transition lose: fail_watch -> loss { when not (alive(allies)); priority 0; }
  }
  binding sc2 {
    allies = unit_group(owner=1, unit_type="Marine", count=4, spawn=point_xy(25.96, 38.5798));
    guards = unit_group(owner=2, unit_type="Zealot", count=3, spawn=point_xy(36.7597, 49.73));
    base = unit(owner=2, unit_type="Nexus", at=point_xy(54.99, 47.18));
    gate = circle(center=point_xy(54.99, 47.18), radius=8);
    __setup__ = setup(terminal_policy="first_wins");
  }
}
