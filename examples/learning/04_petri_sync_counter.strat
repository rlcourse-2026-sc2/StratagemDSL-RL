// v0.6 lesson 4: example 02 (join + killed_in counter) written as a Petri net.
//
//   * no `join` node: `release` has two input arcs, so it waits for BOTH the
//     arrival token and two kill tokens (`kills*2` is a weighted arc);
//   * the kill counter is a token place fed by a repeatable watcher phase;
//     `kill_slots` is its complement place, so at most two deaths are counted
//     and the counter is provably bounded.
strategy PetriSyncCounter {
  world {
    force allies { side = "ally"; role = "main_attack"; }
    force guards { side = "enemy"; role = "mobile_defense"; }
    asset base { side = "enemy"; role = "critical"; }
    region gate { role = "observation_zone"; }
  }
  intent {
    primary destroyed(base);
    success destroyed(base);
    failure not (alive(allies));
  }
  plan {
    start [approach_watch, kill_watch, fail_watch];
    place kills { purpose "one token per guard that died inside the gate"; capacity 2; }
    place kill_slots { purpose "guard deaths still worth counting"; initial 2; capacity 2; }
    phase approach_watch { purpose "Observe the allies' arrival"; }
    phase arrived { purpose "Allies stand at the gate"; actors [allies]; focus [base]; }
    phase kill_watch { purpose "Count guard deaths in the gate"; repeatable; }
    phase exploit {
      purpose "Attack once arrival and two kills are both in";
      actors [allies];
      focus [base];
      do { attack(allies, base); }
    }
    phase win { purpose "Confirm the objective"; terminal success; }
    phase fail_watch { purpose "Observe allied defeat"; }
    phase loss { purpose "Record failure"; terminal failure; }
    transition arrival: approach_watch -> arrived {
      on enter(allies, gate);
      when alive(allies);
      priority 10;
    }
    transition count_kill: kill_watch, kill_slots -> kill_watch, kills {
      on unit_died(guards);
      when event_in(gate);
      priority 10;
    }
    transition release: arrived, kills*2 -> exploit {
      when (in_region(allies, gate) and alive(allies));
      priority 10;
    }
    transition finish: exploit -> win {
      when (destroyed(base) and not (not (alive(allies))));
      priority 10;
    }
    transition lose: fail_watch -> loss {
      when not (alive(allies));
      priority 0;
    }
  }
  binding sc2 {
    allies = unit_group(owner=1, unit_type="Marine", count=4, spawn=point_xy(25.96, 38.5798));
    guards = unit_group(owner=2, unit_type="Zealot", count=3, spawn=point_xy(36.7597, 49.73));
    base = unit(owner=2, unit_type="Nexus", at=point_xy(54.99, 47.18));
    gate = circle(center=point_xy(54.99, 47.18), radius=8);
    __setup__ = setup(terminal_policy="first_wins");
  }
}
