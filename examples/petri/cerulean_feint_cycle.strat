// 声东击西 (Feint) as a Petri net, on assets/base_maps/cerulean_fall_le.SC2Map.
// Every position is a point_xy checked against the map's terrain (strat mapinfo --check).
//
//   Terran (player 1) starts on the south-west high ground (P1, level 3).
//   Protoss (player 2): main Nexus on the north plateau (P2), expansion Nexus
//   on the east plateau (P4), guarded by the mobile defenders.
//
//   * Hellions run up the R5 ramp and threaten the main Nexus (fake target);
//     the defenders are retargeted to the main, leaving the expansion open.
//   * The feint repeats up to three times (feint <-> regroup is a cycle that
//     spends `feint_budget`); each answered feint leaves a token in `pulled`.
//   * The Marine/Marauder force strikes the expansion when either signal holds:
//       go            ?pulled (read arc) and the expansion is nearly empty
//       go_attrition  losses*3: three defender deaths, counted with the
//                     complement place kill_slots so the counter is bounded
strategy cerulean_feint_cycle {
  world {
    force feint_force { side = "ally"; role = "decoy"; }
    force main_force { side = "ally"; role = "main_attack"; }
    force defenders { side = "enemy"; role = "mobile_defense"; }
    asset command_center { side = "ally"; role = "home_base"; }
    asset enemy_main { side = "enemy"; role = "fake_target"; }
    asset enemy_expansion { side = "enemy"; role = "real_target"; }
    region main_threat_zone { role = "feint_trigger"; }
    region expansion_zone { role = "real_target_area"; }
    region staging_zone { role = "regroup_zone"; }
  }
  initial { alive(feint_force); alive(main_force); alive(defenders); alive(enemy_main); alive(enemy_expansion); }
  intent {
    pattern Feint {
      decoy = feint_force;
      fake_target = enemy_main;
      defenders = defenders;
      main_force = main_force;
      real_target = enemy_expansion;
    }
    primary destroyed(enemy_expansion);
    secondary alive(main_force);
    success destroyed(enemy_expansion);
    failure not (alive(main_force));
  }
  semantics {
    derive expansion_exposed = (count_in(defenders, expansion_zone) < 2);
  }
  plan {
    start [feint, kill_watch, strike_wait, failure_watch];
    place feint_budget { purpose "extra feints the Hellions may still run"; initial 2; capacity 2; }
    place pulled { purpose "one token per feint that pulled the defenders"; capacity 3; }
    place kill_slots { purpose "defender deaths still to be counted"; initial 3; capacity 3; }
    place losses { purpose "counted defender deaths"; capacity 3; }
    phase feint {
      purpose "Hellions run up the north ramp and threaten the Protoss main Nexus.";
      repeatable;
      actors [feint_force];
      focus [enemy_main];
      do { move(feint_force, main_threat_zone); }
    }
    phase regroup {
      purpose "Hellions fall back to the lowland below the ramp to threaten again.";
      repeatable;
      actors [feint_force];
      focus [defenders];
      do { move(feint_force, staging_zone); }
    }
    phase kill_watch {
      purpose "Count defender deaths; each one moves a token from kill_slots to losses.";
      repeatable;
      actors [main_force];
      focus [defenders];
    }
    phase strike_wait {
      purpose "Hold the Marines and Marauders on the home plateau until the feint works.";
      actors [main_force];
      focus [enemy_expansion];
      do { hold(main_force); }
    }
    phase strike {
      purpose "Attack the east expansion while the defenders are away at the main.";
      actors [main_force];
      focus [enemy_expansion];
      do { attack(main_force, enemy_expansion); }
    }
    phase won { purpose "The expansion is destroyed while the main force survives."; actors [main_force]; terminal success; }
    phase failure_watch { purpose "Independently watch intent.failure."; }
    phase lost { purpose "Explicit failure terminal."; terminal failure; }
    transition threat: feint -> regroup, pulled {
      on enter(feint_force, main_threat_zone);
      when not (not (alive(main_force)));
      do { retarget(defenders, enemy_main); }
      priority 10;
    }
    transition feint_again: regroup, feint_budget -> feint {
      on enter(feint_force, staging_zone);
      when alive(feint_force);
      priority 10;
    }
    transition count_kill: kill_watch, kill_slots -> kill_watch, losses {
      on unit_died(defenders);
      priority 10;
    }
    transition go: strike_wait, ?pulled -> strike {
      when ((expansion_exposed and alive(main_force)) and not (not (alive(main_force))));
      priority 10;
    }
    transition go_attrition: strike_wait, losses*3 -> strike {
      when (alive(main_force) and not (not (alive(main_force))));
      priority 11;
    }
    transition confirm: strike -> won {
      when (destroyed(enemy_expansion) and not (not (alive(main_force))));
      priority 10;
    }
    transition lose: failure_watch -> lost {
      when not (alive(main_force));
      priority 0;
    }
  }
  binding sc2 {
    feint_force = unit_group(owner=1, unit_type="Hellion", count=4, spawn=point_xy(14, 25));
    main_force = unit_group(owner=1, composition=[unit(unit_type="Marine", count=12), unit(unit_type="Marauder", count=4)], spawn=point_xy(22, 22));
    command_center = unit(owner=1, unit_type="CommandCenter", at=point_xy(16.5, 18.5));
    defenders = unit_group(owner=2, composition=[unit(unit_type="Stalker", count=4), unit(unit_type="Zealot", count=4), unit(unit_type="Immortal", count=1)], spawn=point_xy(64, 14));
    enemy_main = unit(owner=2, unit_type="Nexus", at=point_xy(44.5, 61.5));
    enemy_expansion = unit(owner=2, unit_type="Nexus", at=point_xy(66.5, 6.5));
    main_threat_zone = circle(center=point_xy(44.5, 61.5), radius=7);
    expansion_zone = circle(center=point_xy(66.5, 6.5), radius=9);
    staging_zone = circle(center=point_xy(24, 47), radius=4);
    __setup__ = setup(terminal_policy="first_wins");
  }
}
